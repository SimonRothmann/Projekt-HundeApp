# Reverse Proxy für Prod + Test, automatisches Let's-Encrypt-TLS pro Domain
# (HTTP-01-Challenge, daher müssen alle vier Domains/Subdomains per DNS
# A-Record auf die VPS-IP zeigen, bevor Caddy startet). Werte aus
# Umgebungsvariablen (siehe docker-compose.yml/.env.example).
{
	email {$ACME_EMAIL}

	# Vor allen Domains steht Cloudflare als Proxy. Ohne diesen Block hält
	# Caddy den Cloudflare-Knoten für den Client und reicht DESSEN Adresse als
	# X-Forwarded-For ans Backend - dessen Drosselung der Anmeldung (10 pro
	# Minute und IP, siehe Program.cs) zählte damit nicht je Person, sondern
	# je Cloudflare-Knoten: Wer zehnmal im Takt ein falsches Passwort schickte,
	# sperrte alle aus, die über denselben Knoten kamen (etwa ganz München),
	# und warf sie beim nächsten Token-Wechsel aus der App.
	#
	# Vertraut wird NUR den Adressbereichen von Cloudflare - wer den Server
	# unter seiner IP direkt anspricht und CF-Connecting-IP selbst setzt, wird
	# ignoriert und mit seiner echten Adresse gezählt.
	# Liste: https://www.cloudflare.com/ips/ (Stand 2026-09-21). Ändert
	# Cloudflare die Bereiche, fällt nichts aus - neue Knoten würden nur wieder
	# gemeinsam gezählt.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Security-Header für alle Sites. HSTS erst nach bewusster Entscheidung mit
# langem max-age: einmal ausgeliefert, erzwingen Browser HTTPS für die Dauer
# von max-age - Rollback auf HTTP ist dann praktisch nicht mehr möglich.
# Kein X-Frame-Options/frame-ancestors auf der API (reine JSON-Antworten),
# aber auf den Frontend-Domains gegen Clickjacking.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# "?" = nur setzen, wenn die Antwort keinen eigenen Wert mitbringt.
		# Die Einladungs- und Anmeldeseiten (/v/…, /anmeldung/…) schicken
		# bewusst "no-referrer", weil der Code in der Adresse der Schlüssel
		# ist; ohne "?" überschrieb dieser Standard ihn. Der Block wird wegen
		# "-Server" erst beim Schreiben der Antwort angewendet und sieht
		# deshalb, was das Frontend gesetzt hat.
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Für die API: genau EINE Adresse als X-Forwarded-For weitergeben - die
# echte des Clients ({client_ip}, siehe servers-Block oben). Das Backend liest
# nur den letzten Eintrag (ForwardLimit 1); eine Kette aus "Client,
# Cloudflare" ergäbe dort wieder den Cloudflare-Knoten.
(api_proxy) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
	}
}

(frontend_headers) {
	import security_headers
	header {
		X-Frame-Options "DENY"
		# Nur die selbst genutzten Browser-Features erlauben (Geolocation für
		# GPS-Aufzeichnung); Kamera/Mikrofon explizit verbieten.
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
	}
}

# Wartung: Ist das Frontend oder das Backend nicht erreichbar (Neustart beim
# Deploy, längere Wartung), erzeugt Caddy selbst den Fehler 502/503/504 - und
# antwortet dann mit einer Wartungsseite statt mit der nackten Fehlermeldung.
# handle_errors greift nur bei solchen von Caddy erzeugten Fehlern; eine Antwort
# der Anwendung selbst (auch ein 503 des Backends) reicht Caddy unverändert
# durch. Die Kopfzeilen der Site-Snippets laufen in der Fehlerroute nicht
# mit und werden hier ausdrücklich erneut eingebunden.
#
# Frontend: die statische Seite aus deploy/caddy/wartung (der Ordner ist als
# Ganzes unter /etc/caddy eingebunden), Status 503, nicht zwischenspeichern.
(wartung_frontend) {
	handle_errors {
		@wartung expression {http.error.status_code} in [502, 503, 504]
		handle @wartung {
			import frontend_headers
			header Retry-After "60"
			header Cache-Control "no-store"
			root * /etc/caddy/wartung
			# Bewusst nicht index.html: file_server leitet Index-Dateien auf das Verzeichnis um.
			rewrite * /wartung.html
			file_server {
				status 503
			}
		}
	}
}

# API: JSON, das das Frontend erkennt (lib/wartung.ts). Das Frontend liegt auf
# einer anderen Herkunft als die API - ohne CORS-Kopfzeilen dürfte der Browser
# die Antwort nicht lesen, und ohne Antwort auf die Vorab-Anfrage (OPTIONS)
# scheiterte jede schreibende Anfrage schon vorher. Normalerweise antwortet
# darauf das Backend; es ist ja gerade nicht da. {args[0]} ist die Domain des
# zugehörigen Frontends und muss zu Cors__AllowedOrigins__0 in docker-compose.yml
# passen. Erlaubt wird wie im Backend jede Methode und jede angefragte Kopfzeile.
(wartung_api) {
	handle_errors {
		@wartung expression {http.error.status_code} in [502, 503, 504]
		handle @wartung {
			import security_headers
			header {
				Access-Control-Allow-Origin "https://{args[0]}"
				Access-Control-Expose-Headers "X-Dogity-Wartung"
				Vary "Origin"
				Cache-Control "no-store"
			}
			@vorabfrage method OPTIONS
			handle @vorabfrage {
				header {
					Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
					Access-Control-Allow-Headers "{http.request.header.Access-Control-Request-Headers}"
				}
				respond 204
			}
			handle {
				header {
					X-Dogity-Wartung "1"
					Retry-After "60"
					Content-Type "application/json"
				}
				respond `{"wartung":true}` 503
			}
		}
	}
}

{$PROD_DOMAIN} {
	import frontend_headers
	import wartung_frontend
	reverse_proxy frontend-prod:3000
}

{$PROD_API_DOMAIN} {
	import security_headers
	import wartung_api {$PROD_DOMAIN}
	import api_proxy backend-prod:8080
}

{$TEST_DOMAIN} {
	import frontend_headers
	import wartung_frontend
	reverse_proxy frontend-test:3000
}

{$TEST_API_DOMAIN} {
	import security_headers
	import wartung_api {$TEST_DOMAIN}
	import api_proxy backend-test:8080
}
