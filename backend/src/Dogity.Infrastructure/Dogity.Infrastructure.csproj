<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Dogity.Application\Dogity.Application.csproj" />
    <ProjectReference Include="..\Dogity.Domain\Dogity.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web Push (VAPID, RFC 8030/8291) für die Push-Benachrichtigungen. Auf
         net5+ ohne BouncyCastle (nur Lib.Net.Http.EncryptedContentEncoding).
         Exakt festgelegt statt "3.*": der Versand hängt an dieser Bibliothek. -->
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="MailKit" Version="4.*" />
    <!-- MimeKit (über MailKit) zieht System.Security.Cryptography.Pkcs 10.0.0 mit
         bekannten Sicherheitslücken (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7).
         Direkt referenziert, damit die neueste 10.0-Fassung greift. Entfernen,
         sobald MimeKit selbst eine behobene Fassung verlangt. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fragenkataloge zur Sachkunde. Erzeugt von scripts/import-sachkunde.py,
         gelesen vom SachkundeSeeder. LogicalName ausdrücklich gesetzt, damit
         der Ressourcenname nicht vom Pfadtrenner der Bauplattform abhängt. -->
    <EmbeddedResource Include="Persistence/Seed/Data/sachkunde-swhv.json"
                      LogicalName="Dogity.Infrastructure.Persistence.Seed.Data.sachkunde-swhv.json" />
    <!-- Englische Texte der FCI-Ordnungen (Paket E4), gelesen von FciTexteEn. -->
    <EmbeddedResource Include="Persistence/Seed/Data/fci-texte-en.json"
                      LogicalName="Dogity.Infrastructure.Persistence.Seed.Data.fci-texte-en.json" />
  </ItemGroup>

</Project>
