# Vorlage für die VPS-.env (siehe deploy/README.md) - Datei mit echten
# Werten NIE committen (.env ist in .gitignore).

# --- Domains (vorher per DNS A-Record auf die VPS-IP zeigen lassen) ---
PROD_DOMAIN=dogity.example.com
PROD_API_DOMAIN=api.dogity.example.com
TEST_DOMAIN=test.dogity.example.com
TEST_API_DOMAIN=api-test.dogity.example.com

# E-Mail für Let's-Encrypt-Benachrichtigungen (Caddy)
ACME_EMAIL=admin@example.com

# --- Datenbank ---
# Mit z.B. `openssl rand -base64 32` erzeugen, je Wert unterschiedlich.
POSTGRES_SUPERUSER_PASSWORD=
DOGITY_PROD_DB_PASSWORD=
DOGITY_TEST_DB_PASSWORD=

# --- JWT-Signaturschlüssel ---
# Mit `openssl rand -base64 48` erzeugen - Prod/Test bewusst unterschiedlich,
# damit ein Token aus Test niemals in Prod gültig ist (und umgekehrt).
PROD_JWT_SECRET=
TEST_JWT_SECRET=

# --- Admin-Bootstrap (optional) ---
# E-Mail-Adresse eines bereits registrierten Nutzers, der beim nächsten
# Start die ADMIN-Rolle bekommt (siehe AdminBootstrapper.cs). Leer lassen,
# um das zu überspringen.
PROD_ADMIN_EMAIL=
TEST_ADMIN_EMAIL=

# --- E-Mail (optional) ---
# Versand über den eigenen Versandserver (Dienst "mail", deploy/mail). Ohne
# SMTP_HOST wird nichts versendet (nur protokolliert). Erst einschalten, wenn
# die DNS-Einträge stehen - Reihenfolge in docs/BETRIEB.md "E-Mail".
# Absender (noreply@PROD_DOMAIN) und Antwortadresse (info@PROD_DOMAIN) sind
# in docker-compose.yml fest eingetragen.
SMTP_HOST=
# Nur für einen externen Relay als Ausweg (dann mit STARTTLS-Pflicht), z. B.
# Host des Dienstes, SMTP_PORT=587, Benutzer und Passwort setzen.
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Dogity
# Testumgebung: nur für die Testphase des Versandservers ("Testmail senden").
TEST_SMTP_HOST=

# --- Push-Benachrichtigungen (optional) ---
# Schlüsselpaar und Kontakt erzeugt `scripts/vapid-schluessel.sh PROD .env` (bzw.
# TEST) - der private Schlüssel erscheint dabei nicht auf dem Bildschirm. Fehlt
# eine der drei Zeilen, ist Push aus. Ein einmal erzeugtes Paar NICHT ersetzen:
# Alle angemeldeten Geräte würden ungültig.
PROD_VAPID_PUBLIC_KEY=
PROD_VAPID_PRIVATE_KEY=
PROD_VAPID_SUBJECT=
TEST_VAPID_PUBLIC_KEY=
TEST_VAPID_PRIVATE_KEY=
TEST_VAPID_SUBJECT=
