{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Dogity.Api", "--launch-profile", "http"],
      "cwd": "backend",
      "port": 5080,
      "autoPort": false
    }
  ]
}
